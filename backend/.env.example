# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentcart?schema=public"
PORT=4000
NODE_ENV=development

# --- LLM: Groq (OpenAI-compatible API) -------------------------------------
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Razorpay Test Mode ----------------------------------------------------
# https://dashboard.razorpay.com -> Test Mode -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Authentication ----------------------------------------------------------
# Signs login tokens. MUST be long and random (>= 32 chars; enforced in production).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Web / networking ---------------------------------------------------------
# Browser origin(s) allowed to call this API, comma separated, no trailing slash.
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API. Use 1 on Render / Railway.
TRUST_PROXY=0

# --- Seed script (optional) -----------------------------------------------------
# Passwords for the demo accounts created by `npm run seed`.
# SEED_MERCHANT_PASSWORD=
# SEED_CUSTOMER_PASSWORD=
