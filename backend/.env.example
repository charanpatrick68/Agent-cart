DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentcart?schema=public"
PORT=4000
NODE_ENV=development

# LLM (Google Gemini API for the Shopping Agent — free tier via aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Razorpay Test Mode credentials — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Session/auth signing secret — generate a long random string for real use
JWT_SECRET=

CORS_ORIGIN=http://localhost:5173
