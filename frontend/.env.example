# Base URL of the deployed API, no trailing slash (e.g. https://agentcart-api.onrender.com).
# Leave empty in local dev — Vite proxies /api to http://localhost:4000.
VITE_API_BASE_URL=

# Optional: show one-click demo logins on the sign-in page (needs `npm run seed` on the backend).
VITE_DEMO_LOGINS=false
